{
  "name": "my-video",
  "version": "0.1.0",
  "description": "Desktop video generation app powered by HyperFrames.",
  "author": "VNP",
  "private": true,
  "type": "module",
  "main": "desktop_app/main.js",
  "scripts": {
    "start": "node desktop_app/ui_server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test tests/*.test.mjs",
    "dev": "hyperframes preview",
    "check": "hyperframes lint && hyperframes validate && hyperframes inspect",
    "render": "hyperframes render --workers=2",
    "publish": "hyperframes publish",
    "generate:news": "node generate.mjs data/sample-news.json",
    "generate:motivation": "node generate.mjs data/sample-motivation.json",
    "generate:finance": "node generate.mjs data/sample-finance.json",
    "render:news": "node generate.mjs data/sample-news.json && hyperframes render --workers=2",
    "render:motivation": "node generate.mjs data/sample-motivation.json && hyperframes render --workers=2",
    "render:finance": "node generate.mjs data/sample-finance.json && hyperframes render --workers=2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.15.0",
    "hyperframes": "^0.6.24",
    "node": "24.14.1",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.38.0",
    "puppeteer": "^25.0.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "vn.vnp.hyperframes",
    "productName": "VNP HyperFrames",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop_app/**",
      "pipeline/**",
      "public/**",
      "templates/**",
      "assets/**",
      "compositions/**",
      ".puppeteer-cache/**",
      "hyperframes.json",
      "meta.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
